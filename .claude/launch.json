{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bluebird-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "bluebird-storybook",
      "autoPort": true,
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx storybook dev -p \"$PORT\" --ci --no-open"
      ],
      "port": 6006
    },
    {
      "name": "jira-proxy",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "jira:proxy"
      ],
      "port": 8787
    },
    {
      "name": "connect",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "connect:dev"
      ],
      "port": 8788
    }
  ]
}
