{
  "name": "bluebird",
  "version": "0.1.0",
  "private": true,
  "description": "Bluebird — persona-based, multi-tab, multi-brand Figma plugin",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "gen": "tsx scripts/gen-registry.ts && tsx scripts/gen-tokens.ts",
    "dev": "npm run gen && vite",
    "dev:sandbox": "npm run gen && tsx scripts/build-sandbox.ts --watch",
    "dev:live": "npm run gen && BB_LIVE=1 tsx scripts/build-sandbox.ts --watch",
    "dev:relay": "tsx tools/relay/server.ts",
    "build": "npm run gen && npm run build:stamp && npm run build:ui && npm run build:sandbox && npm run check:size",
    "build:stamp": "tsx scripts/bump-build.ts",
    "build:ui": "vite build && BB_TARGET=bridge vite build",
    "build:sandbox": "tsx scripts/build-sandbox.ts",
    "check:size": "tsx scripts/check-size.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern '.claude/**'",
    "lint:fix": "eslint . --ignore-pattern '.claude/**' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:flows": "playwright test --project=flows",
    "verify": "npm run typecheck && npm run lint && npm run tokens:check && npm run test:coverage && npm run build && npm run test:e2e",
    "gen:tokens": "tsx scripts/gen-tokens.ts",
    "tokens:check": "tsx scripts/check-tokens.ts",
    "figma:parity": "node --env-file-if-exists=.env --import tsx scripts/figma-parity.ts",
    "figma:visual": "node --env-file-if-exists=.env --import tsx scripts/figma-visual.ts",
    "figma:diff": "node --env-file-if-exists=.env --import tsx scripts/figma-diff.ts",
    "jira:proxy": "tsx tools/jira-proxy/server.ts",
    "figma:pull": "node --env-file-if-exists=.env --import tsx scripts/figma-pull.ts",
    "storybook": "npm run gen:tokens && storybook dev -p 6006",
    "build-storybook": "npm run gen:tokens && storybook build",
    "tokens:map": "tsx scripts/map-tokens.ts",
    "access-code": "tsx scripts/access-code.ts",
    "gt": "tsx scripts/ground-truth.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.2.0",
    "preact": "^10.26.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/preact-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^20.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "jsdom": "^26.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  }
}
