{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bluebird plugin config",
  "type": "object",
  "required": [
    "brand",
    "activePersona",
    "personas",
    "tabs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "required": [
        "active",
        "brands"
      ],
      "properties": {
        "active": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "brands": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "label",
              "source",
              "accessCodeHash"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "source": {
                "type": "object",
                "required": [
                  "collection",
                  "mode"
                ],
                "properties": {
                  "collection": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  }
                }
              },
              "fallbackTokens": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "accessCodeHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 hex of the brand access code (trimmed, upper-cased). Generate with `npm run access-code -- <code>`."
              },
              "tabs": {
                "type": "array",
                "description": "This brand's tab bar: array order is tab order, enabled:false hides the tab. Tabs not listed follow in persona order. Edit in dev.html \u203a Plugin configuration.",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "enabled"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "personas": {
                "type": "object",
                "description": "Which tabs each persona gets in this brand, by persona id. A persona not listed keeps personas.<id>.tabs; an empty list drops it from this brand. Edit in dev.html \u203a Plugin configuration.",
                "propertyNames": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "additionalProperties": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  }
                }
              },
              "integrations": {
                "type": "object",
                "description": "Settings sections this brand sets for everyone; the plugin shows these fields locked. API keys and tokens are not allowed here: each person enters them in the plugin.",
                "additionalProperties": false,
                "properties": {
                  "github": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "notifications": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "storybook": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "zeroheight": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "dualFile": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "ai": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "mcp": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  },
                  "jira": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "boolean"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "activePersona": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "personas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Off keeps the persona in the file but out of the picker and Settings."
          },
          "tabs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tabs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      }
    },
    "window": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 760
        },
        "height": {
          "type": "integer",
          "minimum": 400,
          "maximum": 960
        }
      }
    }
  }
}
