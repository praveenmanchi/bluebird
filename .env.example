# Copy to `.env` (git-ignored) and fill in. `npm run figma:pull`, `figma:diff` and
# `figma:visual` read FIGMA_TOKEN; the plugin build reads only VITE_* lines.
#
# Figma personal access token — https://www.figma.com/developers/api#access-tokens
# Settings → Security → Personal access tokens → Generate new token.
# Scopes: file_content:read, file_variables:read (variables need an Enterprise plan;
# without it the components, properties, bindings and geometry still pull fine).
# The token's account must be able to open the file in figma/manifest.json, or REST answers 404.
FIGMA_TOKEN=

# Where the plugin reports access-code logins (src/shared/analytics/login.ts). Empty = none.
# Staging is in manifest.json devAllowedDomains, so only development copies of the plugin can reach it.
VITE_LOGIN_ANALYTICS_URL=

# For `npm run connect:logins`: your Cloudflare account id and an API token with
# Account › Account Analytics › Read (dash.cloudflare.com/profile/api-tokens).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
